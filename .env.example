VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Use mock locally until Firebase Auth and the callable gateway have been configured.
VITE_NOBLESSE_COMMERCE_MODE=mock
VITE_FIREBASE_FUNCTIONS_REGION=asia-northeast3
# Optional until the Firebase project owner configures App Check. Once configured,
# set this key and restore `enforceAppCheck: true` in functions/index.js.
VITE_FIREBASE_APPCHECK_SITE_KEY=your-recaptcha-v3-site-key
